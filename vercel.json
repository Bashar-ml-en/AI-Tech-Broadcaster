{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/story",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reel",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/post",
      "schedule": "0 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
