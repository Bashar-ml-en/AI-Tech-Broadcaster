# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment and sensitive keys
config/.env
*.env
!config/.env.example

# Local SQLite databases and logs
storage/*.db
storage/*.lock
storage/.*.lock
storage/tiktok_token.json
storage/logs/*.log
storage/staging/*.mp4
storage/staging/*.png
storage/staging/*.jpg
storage/staging/*.txt
storage/staging/*.mp3
storage/staging/*.wav
!storage/staging/.gitkeep
!storage/logs/.gitkeep

# IDE and OS files
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store
