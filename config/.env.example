# ==============================================================================
# AI TECH BROADCASTER - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to config/.env and replace placeholders with your actual keys.
# Never commit config/.env (it is gitignored).
# ==============================================================================

# Runtime Environment
ENVIRONMENT=production
LOG_LEVEL=INFO
# Multi-Cadence Autonomous Schedules
SCHEDULE_STORY_MINUTES=15
SCHEDULE_REEL_MINUTES=30
SCHEDULE_POST_MINUTES=60
SCHEDULE_INTERVAL_HOURS=1

# Local SQLite Storage
DATABASE_PATH=storage/published_history.db
STAGING_DIR=storage/staging
LOGS_DIR=storage/logs

# ------------------------------------------------------------------------------
# Autonomous Publishing Control
#   PUBLISH_MODE: simulate = never call platform APIs (safe default)
#                 auto     = live where credentials exist, simulated elsewhere
#                 live     = live everywhere; missing credentials => failure
# ------------------------------------------------------------------------------
PUBLISH_MODE=simulate
ENABLED_PLATFORMS=facebook,instagram,threads,tiktok
# Quality gate: block (recommended) | warn
QUALITY_GATE_MODE=block
# Passive Telegram mirror of published posts and gate blocks (not an approval gate)
TELEGRAM_MIRROR=false

# Cloudflare R2 Object Storage (required for live Meta/Threads publishing:
# platforms fetch media from a public HTTPS URL)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=broadcaster-staging
# Public bucket URL (r2.dev subdomain or custom domain bound to the bucket)
CLOUDFLARE_R2_PUBLIC_URL=

# Meta Graph API (Facebook Page + Instagram Professional account)
# Scopes: pages_manage_posts, pages_read_engagement, instagram_basic, instagram_content_publish
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v20.0

# Meta Threads API  (Scopes: threads_basic, threads_content_publish)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# TikTok Content Posting API v2  (Scopes: video.publish, video.upload)
# Access tokens expire every 24h; the refresh token is used automatically.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=

# Telegram (optional passive mirror / alerts only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PUBLIC_BASE_URL=

# Legacy aggregators (not used by the autonomous dispatcher)
AYRSHARE_API_KEY=
AYRSHARE_PROFILE_KEY=

# Google GenAI / Director Settings
GEMINI_API_KEY=
DIRECTOR_MODEL=gemini-3.8-flash
GEMINI_THINKING_BUDGET=2048
GEMINI_THINKING_LEVEL=high
SUPER_QUALITY_THRESHOLD=8.0
REPAIR_AUTO_APPLY=true
VEO_MODEL=veo-3.1-fast
IMAGEN_MODEL=imagen-3.0
